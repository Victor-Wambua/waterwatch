{
  "openapi": "3.1.0",
  "info": {
    "title": "WaterWatch API",
    "version": "0.1.0",
    "description": "Session-cookie authenticated JSON API (plus device-signed ingestion). Unsafe methods require the X-CSRF-Token header (GET /api/v1/csrf). Not production ready."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4400"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ww_sid"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      },
      "deviceSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WW-Signature",
        "description": "HMAC-SHA256 hex of \"<deviceKey>\\n<timestamp>\\n<nonce>\\n<sha256hex(body)>\" with the device secret. Also send X-WW-Device, X-WW-Timestamp (unix seconds), X-WW-Nonce."
      }
    }
  },
