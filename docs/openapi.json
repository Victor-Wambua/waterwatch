        "summary": "Liveness and database check",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not permitted"
          },
          "404": {
            "description": "Not found (also used for other tenants' records)"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
