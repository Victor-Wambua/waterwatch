# WaterWatch environment (copy to .env; never commit real secrets)
PORT=4400
WW_ENV=development            # development | test | staging | production
WW_DB_PATH=data/waterwatch.sqlite
WW_DATA_DIR=data/files        # private photo storage (never served statically)
WW_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars   # encrypts device secrets and MFA seeds at rest
WW_COOKIE_SECURE=0            # set 1 behind TLS
WW_TRUST_PROXY=0              # set 1 only behind a proxy you control (uses X-Forwarded-For)
WW_ALLOW_SIMULATED=1          # allow simulated devices (forced off when WW_ENV=production)
WW_TILE_URL=                  # optional tile provider URL template; empty = tiles OFF (schematic map)
WW_TILE_ATTRIBUTION=
WW_HEALTH_INTERVAL_MS=60000   # sensor health + planned-maintenance job interval; 0 disables
WW_SEED_ON_START=0            # 1 seeds the SYNTHETIC demo utility if the DB is empty
WW_SEED_PASSWORD=             # password for seeded demo users (random and printed if empty)
